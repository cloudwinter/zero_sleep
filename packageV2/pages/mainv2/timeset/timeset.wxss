/* pages/mainv2/timeset/timeset.wxss */

.item {
  width: 100%;
  height: 88rpx;
  background: #2B2D36;
  display: flex;
  align-items: center;
}


.item-left {
  flex: 1;
  color: white;
  font-size: 28rpx;
  margin-left: 62rpx;
}

.item-right {
  display: flex;
  align-items: center;
  margin-right: 50rpx;
}

.item-right-name {
  color: #59B84D;
  font-size: 28rpx;
}

.item-right-icon {
  width: 40rpx;
  height: 40rpx;
  margin-left: 20rpx;
}


.dialog-item {
  height: 80rpx;
  width: 100%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
}

.dialog-item .checkbox {
  margin-left: 20rpx;
}

.dialog-item-name {
  margin-left: 10rpx;
}

.model-label{
  display: flex;
  align-items: center;
  height: 120rpx;
}

.radio {
  display: block;
  padding: 5px;
  width: 100%;
}