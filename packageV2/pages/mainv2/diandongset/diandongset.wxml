<!--pages/mainv2/diandongset/diandongset.wxml-->
<view class="page-{{skin}}">
	<navbar loading="{{navbar.loading}}" show="{{navbar.show}}" color="{{navbar.color}}" set="{{navbar.set}}" background="{{navbar.background}}" title="电动床设置"></navbar>
	<scroll-view scroll-y="true" showScrollbar="false" style="height:{{containerHeight}}px">
		<view class="scroll">
			<view class="header" bindtap="selectModeTap" data-index="anmo">
				<image src="/images/{{skin}}/anmo-qiangdu@2x.png" class="header-icon"></image>
				<view class="header-title">按摩设置</view>
				<image class="header-arror" src="{{anMoModeIndex?'/images/dark/arror-down.png':'/images/dark/arror-up.png' }}" mode="aspectFit"></image>
			</view>

			<view class="shijian" wx:if="{{anMoModeIndex}}">
				<view class="shijian-button left button-bg-normal {{currentTimeSelected=='10min'?'button-bg-selected':'button-bg'}}">
					<view class="shijian-button-content" bindtap="timeClick" data-time="10min">
						<image wx:if="{{currentTimeSelected!='10min'}}" class="shijian-icon" src="/images/{{skin}}/time-10-normal@2x.png"></image>
						<image wx:else class="shijian-icon" src="/images/{{skin}}/time-10-selected@2x.png"></image>
						<view class="name {{currentTimeSelected=='10min'?'text-selected':'text-normal'}}">10min</view>
					</view>
				</view>

				<view class="middle">
					<view class="shijian-button button-bg-normal {{currentTimeSelected=='20min'?'button-bg-selected':'button-bg'}}">
						<view class="shijian-button-content" bindtap="timeClick" data-time="20min">
							<image wx:if="{{currentTimeSelected!='20min'}}" class="shijian-icon" src="/images/{{skin}}/time-20-normal@2x.png"></image>
							<image wx:else class="shijian-icon" src="/images/{{skin}}/time-20-selected@2x.png"></image>
							<view class="name {{currentTimeSelected=='20min'?'text-selected':'text-normal'}}">20min</view>
						</view>
					</view>
				</view>

				<view class="shijian-button right button-bg-normal {{currentTimeSelected=='30min'?'button-bg-selected':'button-bg'}}">
					<view class="shijian-button-content" bindtap="timeClick" data-time="30min">
						<image wx:if="{{currentTimeSelected!='30min'}}" class="shijian-icon" src="/images/{{skin}}/time-30-normal@2x.png"></image>
						<image wx:else class="shijian-icon" src="/images/{{skin}}/time-30-selected@2x.png"></image>
						<view class="name {{currentTimeSelected=='30min'?'text-selected':'text-normal'}}">30min</view>
					</view>
				</view>
			</view>
			<view class="anmo-type" wx:if="{{anMoModeIndex}}">
				<view class="anmo-content anmo-button-bg button-bg">
					<view class="anmo-button-top">
						<view class="anmo-button-top-left" bindtap="tapMinus" data-type="anmopinglv">
							<image class="anmo-button-icon" src="/images/{{skin}}/minus-normal@3x.png"></image>
						</view>
						<view class="anmo-button-top-middle">
							<image class="anmo-type-icon" src="/images/{{skin}}/anmopinglv@3x.png"></image>
							<view class="anmo-type-name">按摩频率</view>
						</view>
						<view class="anmo-button-top-right" bindtap="tapPlus" data-type="anmopinglv">
							<image class="anmo-button-icon" src="/images/{{skin}}/plus-normal@3x.png"></image>
						</view>

					</view>
					<view class="anmo-button-bottom">
            <view wx:if="{{anmopinglv>=1}}" class="line4 line-color"></view>
						<view wx:if="{{anmopinglv>=2}}" class="line4 line-color"></view>
						<view wx:if="{{anmopinglv>=3}}" class="line4 line-color"></view>
						<view wx:if="{{anmopinglv>=4}}" class="line4 line-color"></view>
					</view>
					<view></view>
				</view>
				<view class="anmo-content anmo-button-bg button-bg">
					<view class="anmo-button-top">
						<view class="anmo-button-top-left" bindtap="tapMinus" data-type="toubu">
							<image class="anmo-button-icon" src="/images/{{skin}}/minus-normal@3x.png"></image>
						</view>
						<view class="anmo-button-top-middle">
							<image class="anmo-type-icon" src="/images/{{skin}}/toubuanmo@3x.png"></image>
							<view class="anmo-type-name">头部按摩</view>
						</view>
						<view class="anmo-button-top-right" bindtap="tapPlus" data-type="toubu">
							<image class="anmo-button-icon" src="/images/{{skin}}/plus-normal@3x.png"></image>
						</view>

					</view>
					<view class="anmo-button-bottom">
						<view wx:if="{{toubu>=1}}" class="line3 line-color"></view>
						<view wx:if="{{toubu>=2}}" class="line3 line-color"></view>
						<view wx:if="{{toubu>=3}}" class="line3 line-color"></view>
					</view>
				</view>
				<view class="anmo-content anmo-button-bg button-bg">
					<view class="anmo-button-top">
						<view class="anmo-button-top-left" bindtap="tapMinus" data-type="tuibu">
							<image class="anmo-button-icon" src="/images/{{skin}}/minus-normal@3x.png"></image>
						</view>
						<view class="anmo-button-top-middle">
							<image class="anmo-type-icon" src="/images/{{skin}}/zubuanmo@3x.png"></image>
							<view class="anmo-type-name">腿部按摩</view>
						</view>
						<view class="anmo-button-top-right" bindtap="tapPlus" data-type="tuibu">
							<image class="anmo-button-icon" src="/images/{{skin}}/plus-normal@3x.png"></image>
						</view>
					</view>
					<view class="anmo-button-bottom">
						<view wx:if="{{tuibu>=1}}" class="line3 line-color"></view>
						<view wx:if="{{tuibu>=2}}" class="line3 line-color"></view>
						<view wx:if="{{tuibu>=3}}" class="line3 line-color"></view>
					</view>
				</view>
				<view class="save" bindtap="saveAnmoTap">保存</view>
			</view>

			<view class="header" bindtap="selectModeTap" data-index="dengguang">
				<image src="/images/{{skin}}/lighting@2x.png" class="header-icon"></image>
				<view class="header-title">灯光设置</view>
				<image class="header-arror" src="{{dengGuangModeIndex?'/images/dark/arror-down.png':'/images/dark/arror-up.png' }}" mode="aspectFit"></image>
			</view>
			<view class="dengguang-type" wx:if="{{dengGuangModeIndex}}">
				<view class="mode">
					<view class="name {{currentDengguangSelected=='10min'?'model-selected':'model-normal'}}" bindtap="dengguangClick" data-time="10min">10分钟</view>
					<view class="name {{currentDengguangSelected=='8h' ?'model-selected':'model-normal'}}" style="margin: 0 30rpx;" bindtap="dengguangClick" data-time="8h">8小时</view>
					<view class="name {{currentDengguangSelected=='10h'?'model-selected':'model-normal'}}" bindtap="dengguangClick" data-time="10h">10小时</view>
				</view>
				<view class="anmo-content anmo-button-bg button-bg">
					<view class="anmo-button-top">
						<view class="anmo-button-top-left" bindtap="tapDengguangMinus" data-type="linght">
							<image class="anmo-button-icon" src="/images/{{skin}}/minus-normal@3x.png"></image>
						</view>
						<view class="anmo-button-top-middle">
							<view class="anmo-type-name">灯光亮度</view>
						</view>
						<view class="anmo-button-top-right" bindtap="tapDengguangPlus" data-type="linght">
							<image class="anmo-button-icon" src="/images/{{skin}}/plus-normal@3x.png"></image>
						</view>
					</view>
					<view class="anmo-button-bottom">
						<block wx:for="{{lineItems}}" wx:key="key">
							<view class="line10 line-color"></view>
						</block>
					</view>
				</view>
				<view class="save" bindtap="saveDengGuangTap">保存</view>
			</view>
			<view class="header" bindtap="selectModeTap" data-index="alarm">
				<image src="/images/{{skin}}/clock@2x.png" class="header-icon"></image>
				<view class="header-title">闹钟设置</view>
				<image class="header-arror" src="{{alarmModeIndex?'/images/dark/arror-down.png':'/images/dark/arror-up.png' }}" mode="aspectFit"></image>
			</view>
			<view class="clock-type" wx:if="{{alarmModeIndex}}">
				<view class="clock-mode">
					<!-- 时间 -->
					<picker class="mode-content" mode="time" value="{{alarm.time}}" start="00:00" end="23:59" bindchange="bindTimeChange" style="width:100%">
						<view class="left">
							<view class="mode-name"><text>时间</text></view>
							<view class="mode-value">{{alarm.time}}</view>
							<image src="/images/dark/row@3x.png" class="mode-row"></image>
						</view>
					</picker>
					<view class="mode-content right" catchtap="periodTap">
						<view class="mode-name"><text>星期</text></view>
						<view class="mode-value">{{alarm.periodDesc}}</view>
						<image src="/images/dark/row@3x.png" class="mode-row"></image>
					</view>
				</view>
				<view class="moshi-content" catchtap="modeTap">
					<view class="moshi-name"><text>模式</text></view>
					<view class="moshi-value">{{alarm.modeName}}</view>
					<image src="/images/dark/row@3x.png" class="moshi-row"></image>
				</view>
				<view class="clock-mode">
					<view class="mode-content left">
						<view class="mode-name"><text>响铃</text></view>
						<switch checked="{{alarm.ring}}" bindchange="ringSwitch" style="transform: scale(0.6);"></switch>
					</view>
					<view class="mode-content right">
						<view class="mode-name"><text>按摩</text></view>
						<switch checked="{{alarm.anmo}}" bindchange="anmoSwitch" style="transform: scale(0.6);"></switch>
					</view>
				</view>
				<view class="save" bindtap="saveAlarmTap" style="margin-bottom: 40rpx;">保存</view>
			</view>
		</view>
	</scroll-view>
</view>



<!-- 周期选择对话框 -->
<view class="modal-dialog" hidden="{{!periodDialogShow}}">
	<view class="modal-box">
		<text class="modal-box-title" style="margin-bottom:30rpx;">星期</text>
		<view class="model-line"></view>
		<view class="modal-box-body">
			<view wx:for="{{periodList}}" wx:key="key" wo:for-item='item' style="width: 100%;">
				<view class="dialog-item" hover-class="item-hover" data-index="{{index}}" data-name="{{item.id}}" bindtap='periodItemSelect'>
					<checkbox class="checkbox" checked="{{item.checked}}" />
					<view class="dialog-item-name">{{item.name}}</view>
				</view>
				<view class="model-line"></view>
			</view>
		</view>
		<view class="model-line"></view>
		<view class="modal-box-bottom" style="height:100rpx;">
			<view bindtap="onModalPeriodClick" data-ctype="cancel" class="modal-box-button" hover-class="modal-box-button-hover" style="flex-grow:1;color:#000">取消</view>
			<view style="width:1rpx;height:100%;background:#eee"></view>
			<view bindtap="onModalPeriodClick" data-ctype="confirm" class="modal-box-button sure" hover-class="modal-box-button-hover" style="flex-grow:1;">确定</view>
		</view>
	</view>
</view>



<!-- 模式对话框 -->
<view class="modal-dialog" hidden="{{!modeDialogShow}}">
	<view class="modal-box">
		<text class="modal-box-title" style="margin-bottom:30rpx;margin-top:30rpx;">模式选择</text>
		<view style="width:100%;height:1px;background:#eee"></view>

		<view class="model-content" style="width:100%;display:flex;justify-content:center">
			<radio-group bindchange="modeRadioChange" class="radio-group" style="width:100%">
				<block wx:for="{{modeItems}}" wx:key="key">
					<label class="model-label">
						<view>
							<radio class="radio" value="{{item.value}}" checked="{{item.value==alarm.modeVal}}" />
						</view>
						<view class="dialog-item-name">{{item.name}}</view>
					</label>
					<view style="width:100%;height:1px;background:#eee"></view>
				</block>
			</radio-group>
		</view>

		<view style="width:100%;height:1px;background:#eee"></view>
		<view class="modal-box-bottom" style="height:100rpx;">
			<view bindtap="onModalModeClick" data-ctype="cancel" class="modal-box-button" hover-class="modal-box-button-hover" style="flex-grow:1;color:black">取消</view>
			<view style="width:1rpx;height:100%;background:#eee"></view>
			<view bindtap="onModalModeClick" data-ctype="confirm" class="modal-box-button sure" hover-class="modal-box-button-hover" style="flex-grow:1;">确定</view>
		</view>
	</view>
</view>


<!-- 模式2对话框 -->
<view class="modal-dialog" hidden="{{!mode2DialogShow}}">
	<view class="modal-box">
		<text class="modal-box-title" style="margin-bottom:30rpx;margin-top:30rpx;">模式选择</text>
		<view style="width:100%;height:1px;background:#eee"></view>

		<view class="model-content" style="width:100%;display:flex;justify-content:center;margin-top:20px;margin-bottom:20px;">
			<view class="dialog-item" hover-class="item-hover">
				<checkbox class="checkbox" checked="{{tempLeftLingyaliChecked}}" data-ctype="left" bindtap="mode2LingyaliCheck" />
				<view class="dialog-item-name">左侧零压力</view>
			</view>

			<view class="dialog-item" hover-class="item-hover">
				<checkbox class="checkbox" checked="{{tempRightLingyaliChecked}}" data-ctype="right" bindtap="mode2LingyaliCheck" />
				<view class="dialog-item-name">右侧零压力</view>
			</view>
		</view>

		<view style="width:100%;height:1px;background:#eee"></view>
		<view class="modal-box-bottom" style="height:100rpx;">
			<view bindtap="onModal2ModeClick" data-ctype="cancel" class="modal-box-button" hover-class="modal-box-button-hover" style="flex-grow:1;color:black">取消</view>
			<view style="width:1rpx;height:100%;background:#eee"></view>
			<view bindtap="onModal2ModeClick" data-ctype="confirm" class="modal-box-button sure" hover-class="modal-box-button-hover" style="flex-grow:1;">确定</view>
		</view>
	</view>
</view>