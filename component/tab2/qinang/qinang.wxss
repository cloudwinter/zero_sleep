/* component/mattress/mattress-M1.wxss */
@import './../../../common/tab.wxss';

/************common****************** */
.dark {
  padding: 0 30rpx;
  box-sizing: border-box;
}

.orange {
  padding: 0 30rpx;
  box-sizing: border-box;
}

.dark .button-bg {
  background: #1E1F24;
}

.dark .button-bg-selected {
  background-color: #1E1F24;
  border: 3rpx solid #5A9927;
}


.orange .button-bg {
  background: #6E269A;
}

.orange .button-bg-selected {
  background-color: #6E269A;
  border: 3rpx solid #FF9704;
}



.anjianqu {
  display: flex;
  margin-top: 30rpx;
  align-items: center;
  height: 200rpx;
}

.anjianqu .anjian-left {
  flex: auto;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}


.anjianqu .anjian-right {
  flex: auto;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: row-reverse;
}

.anjian-bg {
  width: 240rpx;
  height: 200rpx;
  background-color: #1E1F24;
  border-radius: 40rpx;
  border: 2rpx solid #1E1F24;
  /* position: absolute;
  z-index: -1; */
}

.anjiian-content {
  display: flex;
  width: 240rpx;
  height: 200rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  position: absolute;
}

.anjiian-content .anjian-icon {
  width: 100rpx;
  height: 80rpx;
}

.anjiian-content .name {
  color: white;
  font-size: 24rpx;
}




.jiyi {
  display: flex;
  height: 120rpx;
  margin-top: 40rpx;
  width: 100%;
}

.jiyi .button {
  width: 324rpx;
  height: 120rpx;
  border-radius: 120rpx;
  display: flex;                                   
  align-items: center;
  justify-content: center;
  box-sizing: border-box;     
}

.jiyi .left {
  width: 324rpx;
  height: 120rpx;
  margin-left: 30rpx;
}

.jiyi .middle {
  flex: auto;
  width: 30rpx;
}

.jiyi .right {
  width: 324rpx;
  height: 120rpx;
  margin-right: 30rpx;
}

.jiyi-button-bg {
  width: 100%;
  height: 120rpx;
  border-radius: 120rpx;
  position: absolute;
  z-index: -1;
}

.jiyi .button .name {
  color: white;
  font-size: 28rpx;
}

.mode {
  display: flex;
  align-items: center;
}

.mode-content {
  flex: 1;
  display: flex;
  align-items: center;
  height: 120rpx;
  border-radius: 60rpx;
  background-color: #1E1F24;
  margin-top: 40rpx;
  padding: 0 32rpx;
  color: #FFF;
}

.mode .left {
  margin-left: 30rpx;
  margin-right: 15rpx;
}

.mode .right {
  margin-right: 30rpx;
  margin-left: 15rpx;
}

.mode-content .mode-name {
  font-size: 24rpx;
  color: #C9C9C9;
  margin-left: 10rpx;
  flex: 1;
}

.mode-content .mode-row {
  width: 54rpx;
  height: 54rpx;
}

.speed {
  display: flex;
  align-items: center;
  margin-top: 60rpx;
}

.speed-content{
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
}

.speed-btn{
  border-radius: 100rpx;
  font-size: 28rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background-color: #1E1F24;
  display: flex;
  align-items: center;
  justify-content: center;
}
