/* component/mattress/mattress-M2.wxss */
@import './../../../common/tab.wxss';

/************common****************** */
.dark {
  padding: 0 30rpx;
  box-sizing: border-box;
}

.orange {
  padding: 0 30rpx;
  box-sizing: border-box;
}

.dark .button-bg {
  background: #1E1F24;
}

.dark .button-bg-selected {
  background-color: #1E1F24;
  border: 3rpx solid #5A9927;
}


.orange .button-bg {
  background: #6E269A;
}

.orange .button-bg-selected {
  background-color: #6E269A;
  border: 3rpx solid #FF9704;
}

.shuiwei-group {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
}

.shuiwei-bg {
  width: 320rpx;
  height: 320rpx;
}

.shuiwei-value-group {
  position: absolute;
  color: white;
  display: flex;
  align-items: flex-end;
  font-size: 28rpx;
}

.shuiwei-value {
  font-size: 64rpx;
  font-weight: 600;
  line-height: 60rpx;
  margin: 0 10rpx;
  display: block;
}

.temperature {
  color: #59B84D;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;

}


.top2 {
  position: relative;
  margin-top: 30rpx;
  height: 140px;
  display: flex;
  flex-direction: column;
  align-items: center;
}


.temp {
  position: absolute;
  top: 6px;
  width: 292.5px;
}

.temp-scale {
  width: 292.5px;
  height: 32px;
  margin-top: 24px;
}


.slider {
  position: absolute;
  width: 21px;
  height: 30px;
  top: 70px;
  z-index: 999;
}

.scale-group {
  width: 292.5px;
  display: flex;
}

.scale {
  height: 24px;
  flex: 1;
  color: white;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  font-size: 24rpx;
}

.scale-unit {
  font-size: 28rpx;
  align-items: flex-end;
}


.mode-content {
  display: flex;
  align-items: center;
  height: 120rpx;
  border-radius: 60rpx;
  background-color: #1E1F24;
  margin-top: 30rpx;
  padding: 0 32rpx;
  color: #FFF;
}

.mode-content .mode-name {
  font-size: 28rpx;
  color: #C9C9C9;
  margin-left: 10rpx;
  flex: 1;
}

.mode-content .mode-row {
  width: 54rpx;
  height: 54rpx;
}

.picker-content {
  width: 630rpx;
  display: flex;
  align-items: center;
  height: 120rpx;
}

.time {
  font-size: 32rpx;
}