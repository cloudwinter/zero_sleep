.page-blue {
  width: 100vw;
  height: 100vh;
  background-color: #1E1F24;
  background-image: url("https://yhjx.oss-cn-beijing.aliyuncs.com/ddc/zero_sleep/2025-07-31_171848_614.png");
  background-repeat: no-repeat;
  background-size: 100% 100%;
  position: relative;
}

.blue {
  height: 100%;
  width: 100%;
}

.blue .text {
  color: black;
}


.blue .text-normal {
  color: white;
}

.blue .text-selected {
  color: #05BF74;
}